module

public import TauCeti.Algebra.Jordan.PowerAssoc
public import TauCeti.Algebra.Jordan.Subalgebra
public import Mathlib.Algebra.Polynomial.AlgebraMap

/-!
# Associative subalgebra generated by a Jordan element

The span of the Jordan powers of an element, including its zeroth power, is the smallest
unital subalgebra containing that element. It is associative and carries the ordinary
polynomial evaluation map.

## Main results

* `powerSubalgebra` is the associative unital subalgebra generated by one element.
* `powerEval_surjective` expresses every element of this subalgebra as a polynomial.

## References

* Faraut and Korányi, *Analysis on Symmetric Cones*, Chapter II.
* Bryan Ehrlich, euclidean-jordan, `EuclideanJordan/Subalgebra.lean` and
  `EuclideanJordan/Spectral.lean` at a83407e4 (https://github.com/ehrlich-b/euclidean-jordan).
-/

public section

namespace TauCeti.Jordan

open Polynomial

variable {R A : Type*} [CommRing R] [NonAssocCommRing A] [Module R A]

/-- The linear span of the powers of a Jordan element, including the unit. -/
@[expose]
def powerSpan (R : Type*) [CommRing R] [Module R A] (x : A) : Submodule R A :=
  Submodule.span R (Set.range (jpow x))

/-- Every power lies in the span of powers. -/
theorem jpow_mem_powerSpan (x : A) (n : ℕ) : jpow x n ∈ powerSpan R x :=
  Submodule.subset_span ⟨n, rfl⟩

/-- The ambient unit is in the span of the powers. -/
theorem one_mem_powerSpan (x : A) : (1 : A) ∈ powerSpan R x := by
  simpa using jpow_mem_powerSpan (R := R) x 0

/-- The generating element is in the span of its powers. -/
theorem self_mem_powerSpan (x : A) : x ∈ powerSpan R x := by
  simpa using jpow_mem_powerSpan (R := R) x 1

variable [IsScalarTower R A A] [SMulCommClass R A A] [IsCommJordan A] [HasUniqueDiv A]

/-- The span of powers of one Jordan element is closed under multiplication. -/
theorem mul_mem_powerSpan {x a b : A} (ha : a ∈ powerSpan R x) (hb : b ∈ powerSpan R x) :
    a * b ∈ powerSpan R x := by
  induction ha, hb using Submodule.span_induction₂ with
  | mem_mem a b ha hb =>
    obtain ⟨i, rfl⟩ := ha
    obtain ⟨j, rfl⟩ := hb
    rw [jpow_mul_jpow]
    exact jpow_mem_powerSpan x _
  | zero_left => simp
  | zero_right => simp
  | add_left a a' b _ _ _ h h' => exact add_mul a a' b ▸ (powerSpan R x).add_mem h h'
  | add_right a b b' _ _ _ h h' => exact mul_add a b b' ▸ (powerSpan R x).add_mem h h'
  | smul_left r a b _ _ h => exact smul_mul_assoc r a b ▸ (powerSpan R x).smul_mem r h
  | smul_right r a b _ _ h => exact mul_smul_comm r a b ▸ (powerSpan R x).smul_mem r h

/-- Multiplication on the span of the powers of one Jordan element is associative. -/
theorem powerSpan_assoc {x a b c : A}
    (ha : a ∈ powerSpan R x) (hb : b ∈ powerSpan R x) (hc : c ∈ powerSpan R x) :
    (a * b) * c = a * (b * c) := by
  have h₃ (i j : ℕ) : ∀ z ∈ powerSpan R x, (jpow x i * jpow x j) * z =
      jpow x i * (jpow x j * z) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨k, rfl⟩ := hy
      simp only [jpow_mul_jpow, Nat.add_assoc]
    | zero => simp
    | add u v _ _ hu hv => simp only [mul_add, hu, hv]
    | smul r u _ hu => simp only [mul_smul_comm, hu]
  have h₂ (i : ℕ) (y : A) (hy : y ∈ powerSpan R x) :
      ∀ z ∈ powerSpan R x, (jpow x i * y) * z = jpow x i * (y * z) := by
    induction hy using Submodule.span_induction with
    | mem w hw => obtain ⟨j, rfl⟩ := hw; exact h₃ i j
    | zero => intro z _; simp
    | add u v _ _ hu hv =>
      intro z hz
      simp only [mul_add, add_mul, hu z hz, hv z hz]
    | smul r u _ hu =>
      intro z hz
      simp only [mul_smul_comm, smul_mul_assoc, hu z hz]
  induction ha using Submodule.span_induction with
  | mem w hw => obtain ⟨i, rfl⟩ := hw; exact h₂ i b hb c hc
  | zero => simp
  | add u v _ _ hu hv => simp only [add_mul, hu, hv]
  | smul r u _ hu => simp only [smul_mul_assoc, hu]

/-- The span of one element's powers, with its inherited multiplication. -/
@[expose]
def powerSubalgebra (R : Type*) [CommRing R] [Module R A] [IsScalarTower R A A]
    [SMulCommClass R A A] (x : A) : NonUnitalSubalgebra R A :=
  (powerSpan R x).toNonUnitalSubalgebra fun _ _ => mul_mem_powerSpan

/-- The one-generated subalgebra is an associative commutative ring. -/
instance (x : A) : CommRing (powerSubalgebra R x) where
  __ := (powerSubalgebra R x).nonAssocCommRingOfUnit
    ⟨1, one_mem_powerSpan x⟩
    (fun y => Subtype.ext (one_mul (y : A)))
  mul_assoc a b c := Subtype.ext (powerSpan_assoc a.property b.property c.property)

/-- The scalars on the one-generated subalgebra agree with the ambient module structure. -/
instance (x : A) : Algebra R (powerSubalgebra R x) :=
  Algebra.ofModule smul_mul_assoc mul_smul_comm

/-- The one-generated subalgebra is contained in precisely those subalgebras containing
the generator and the ambient unit. -/
theorem powerSubalgebra_le_iff {x : A} {S : NonUnitalSubalgebra R A} :
    powerSubalgebra R x ≤ S ↔ (1 : A) ∈ S ∧ x ∈ S := by
  constructor
  · intro h
    exact ⟨h (one_mem_powerSpan x), h (self_mem_powerSpan x)⟩
  · rintro ⟨h₁, hx⟩
    change powerSpan R x ≤ S.toSubmodule
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨n, rfl⟩
    induction n with
    | zero => exact h₁
    | succ n ih => exact S.mul_mem hx ih

/-- Polynomial evaluation into the associative subalgebra generated by `x`. -/
noncomputable def powerEval (x : A) : R[X] →ₐ[R] powerSubalgebra R x :=
  aeval ⟨x, self_mem_powerSpan x⟩

/-- Polynomial evaluation uses the generator as the value of the indeterminate. -/
theorem powerEval_eq_aeval (x : A) :
    powerEval (R := R) x = aeval (⟨x, self_mem_powerSpan x⟩ : powerSubalgebra R x) :=
  (rfl)

/-- A monomial with coefficient one evaluates to the corresponding Jordan power. -/
@[simp] theorem coe_powerEval_X_pow (x : A) (n : ℕ) :
    ((powerEval (R := R) x (X ^ n) : powerSubalgebra R x) : A) = jpow x n := by
  induction n with
  | zero => simp only [pow_zero, map_one, jpow_zero]; rfl
  | succ n ih =>
    rw [pow_succ', map_mul]
    change (↑(powerEval (R := R) x X) : A) * ↑(powerEval (R := R) x (X ^ n)) =
      x * jpow x n
    rw [ih]
    simp [powerEval]

/-- Every element of the generated subalgebra is the value of a polynomial in the generator. -/
theorem powerEval_surjective (x : A) : Function.Surjective (powerEval (R := R) x) := by
  intro y
  have hy : (y : A) ∈ powerSpan R x := y.property
  have hl : ∀ a ∈ powerSpan R x, ∃ p, (↑(powerEval (R := R) x p) : A) = a := by
    intro a ha
    induction ha using Submodule.span_induction with
    | mem a ha => obtain ⟨n, rfl⟩ := ha; exact ⟨X ^ n, coe_powerEval_X_pow x n⟩
    | zero => exact ⟨0, by rw [map_zero]; rfl⟩
    | add a b _ _ ha hb =>
      obtain ⟨p, rfl⟩ := ha
      obtain ⟨q, rfl⟩ := hb
      exact ⟨p + q, by rw [map_add]; rfl⟩
    | smul r a _ ha =>
      obtain ⟨p, rfl⟩ := ha
      exact ⟨r • p, by rw [map_smul]; rfl⟩
  obtain ⟨p, hp⟩ := hl y hy
  exact ⟨p, Subtype.ext hp⟩

end TauCeti.Jordan
