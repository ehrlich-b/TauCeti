module

public import TauCeti.Algebra.Jordan.Generated
public import TauCeti.Algebra.Polynomial.RealClosed.FormallyReal
public import Mathlib.Algebra.Ring.Idempotent
public import Mathlib.LinearAlgebra.Lagrange

/-!
# Spectral resolution of a Euclidean Jordan algebra element

Inside the associative subalgebra generated by an element, the Lagrange polynomials at the
distinct roots of its minimal polynomial yield the spectral idempotents.

## Main results

* `IsCompleteSystem`: a finite family of nonzero orthogonal idempotents summing to the unit.
* `spectralResolution`: each element of a formally real finite-dimensional Jordan algebra
  admits a spectral resolution with distinct real coefficients. Its idempotents lie in the
  span of powers and evaluate every polynomial by its values on the coefficients.

## References

* Faraut and Korányi, *Analysis on Symmetric Cones*, Theorem III.1.1.
* Bryan Ehrlich, euclidean-jordan, `EuclideanJordan/Spectral.lean` and
  `EuclideanJordan/Frame.lean` at a83407e4 (https://github.com/ehrlich-b/euclidean-jordan).
-/

public section

namespace TauCeti.Jordan

open Polynomial

/-- A finite complete system consists of nonzero orthogonal idempotents that sum to the unit. -/
structure IsCompleteSystem {J ι : Type*} [NonAssocSemiring J] [Fintype ι]
    (p : ι → J) : Prop where
  /-- Every member is nonzero. -/
  nonzero : ∀ i, p i ≠ 0
  /-- Every member is an idempotent. -/
  idempotent : ∀ i, IsIdempotentElem (p i)
  /-- Distinct members are orthogonal. -/
  orthogonal : ∀ i j, i ≠ j → p i * p j = 0
  /-- The members sum to the unit. -/
  sum_eq_one : ∑ i, p i = 1

private theorem aeval_eq_sum_lagrange_of_roots_mem {A : Type*} [CommRing A] [Algebra ℝ A]
    [IsFormallyReal A] {a : A} (ha : IsIntegral ℝ a) {S : Finset ℝ}
    (hS : ∀ r ∈ (minpoly ℝ a).roots, r ∈ S) {n : ℕ} (e : Fin n ≃ ↥S) (f : ℝ[X]) :
    aeval a f = ∑ i, f.eval (e i : ℝ) • aeval a (Lagrange.basis S id (e i : ℝ)) := by
  classical
  have hinterp : aeval a f = aeval a (Lagrange.interpolate S id f.eval) :=
    minpoly.aeval_eq_of_eqOn_roots_of_isFormallyReal ha fun r hr =>
      (Lagrange.eval_interpolate_at_node f.eval Function.injective_id.injOn (hS r hr)).symm
  rw [hinterp, Lagrange.interpolate_apply, map_sum]
  simp only [map_mul, aeval_C, ← Algebra.smul_def]
  let w (r : ℝ) := f.eval r • aeval a (Lagrange.basis S id r)
  exact (Finset.sum_coe_sort S w).symm.trans (e.sum_comp (fun r : S => w r)).symm

private theorem aeval_lagrange_system {A : Type*} [CommRing A] [Algebra ℝ A]
    [IsFormallyReal A] {a : A} (ha : IsIntegral ℝ a) :
    ∃ (n : ℕ) (p : Fin n → A) (coeff : Fin n → ℝ),
      IsCompleteSystem p ∧ Function.Injective coeff ∧
        ∀ f : ℝ[X], aeval a f = ∑ i, f.eval (coeff i) • p i := by
  classical
  let S := (minpoly ℝ a).roots.toFinset
  let b (r : ℝ) := Lagrange.basis S id r
  have hb (r s : ℝ) (hr : r ∈ S) (hs : s ∈ S) : (b r).eval s = if r = s then 1 else 0 := by
    split_ifs with h
    · subst s
      exact Lagrange.eval_basis_self (v := (id : ℝ → ℝ)) (fun _ _ _ _ h => h) hr
    · exact Lagrange.eval_basis_of_ne (v := (id : ℝ → ℝ)) h hs
  let n := Fintype.card S
  let e : Fin n ≃ S := (Fintype.equivFin S).symm
  let c (i : Fin n) : ℝ := e i
  let p (i : Fin n) : A := aeval a (b (c i))
  have hc : Function.Injective c := Subtype.val_injective.comp e.injective
  have hmem (i : Fin n) : c i ∈ S := (e i).property
  have heval (f : ℝ[X]) : aeval a f = ∑ i, f.eval (c i) • p i :=
    aeval_eq_sum_lagrange_of_roots_mem ha (fun _ hr => Multiset.mem_toFinset.mpr hr) e f
  refine ⟨n, p, c, ⟨?_, ?_, ?_, ?_⟩, hc, heval⟩
  · intro i hi
    have hmin := minpoly.dvd ℝ a (show aeval a (b (c i)) = 0 from hi)
    have hroot : (minpoly ℝ a).IsRoot (c i) :=
      isRoot_of_mem_roots (Multiset.mem_toFinset.mp (hmem i))
    have h := (dvd_iff_isRoot.mpr hroot).trans hmin
    have hzero := IsRoot.def.mp (dvd_iff_isRoot.mp h)
    rw [hb _ _ (hmem i) (hmem i), ite_eq_left rfl] at hzero
    exact one_ne_zero hzero
  · intro i
    change aeval a (b (c i)) * aeval a (b (c i)) = aeval a (b (c i))
    rw [← map_mul]
    apply minpoly.aeval_eq_of_eqOn_roots_of_isFormallyReal ha
    intro s hs
    simp only [eval_mul, hb _ _ (hmem i) (Multiset.mem_toFinset.mpr hs)]
    split_ifs <;> simp
  · intro i j hij
    change aeval a (b (c i)) * aeval a (b (c j)) = 0
    rw [← map_mul, ← map_zero (aeval (R := ℝ) a)]
    apply minpoly.aeval_eq_of_eqOn_roots_of_isFormallyReal ha
    intro s hs
    simp only [eval_zero, eval_mul, hb _ _ (hmem i) (Multiset.mem_toFinset.mpr hs),
      hb _ _ (hmem j) (Multiset.mem_toFinset.mpr hs)]
    by_cases hi : c i = s
    · have hj : c j ≠ s := fun hj => hij (hc (hi.trans hj.symm))
      rw [ite_eq_left hi, ite_eq_right hj, mul_zero]
    · rw [ite_eq_right hi, zero_mul]
  · simpa using (heval 1).symm

variable {J : Type*} [NonAssocCommRing J] [Module ℝ J] [SMulCommClass ℝ J J]
  [IsScalarTower ℝ J J] [IsCommJordan J] [Module.Finite ℝ J] [IsFormallyReal J]

/-- Every element of a finite-dimensional formally real Jordan algebra is a linear combination
of a complete system of idempotents with pairwise distinct real coefficients.
The idempotents lie in the span of powers and give the polynomial evaluation formula. -/
theorem spectralResolution (x : J) :
    ∃ (n : ℕ) (p : Fin n → J) (coeff : Fin n → ℝ),
      IsCompleteSystem p ∧ Function.Injective coeff ∧ (x = ∑ i, coeff i • p i) ∧
        (∀ i, p i ∈ powerSpan ℝ x) ∧
          ∀ f : ℝ[X], (↑(powerEval (R := ℝ) x f) : J) = ∑ i, f.eval (coeff i) • p i := by
  let S := powerSubalgebra ℝ x
  let a : S := ⟨x, self_mem_powerSpan x⟩
  obtain ⟨n, p, c, hp, hc, heval⟩ := aeval_lagrange_system (IsIntegral.of_finite ℝ a)
  refine ⟨n, fun i => (p i : J), c, ⟨?_, ?_, ?_, ?_⟩, hc, ?_, ?_, ?_⟩
  · exact fun i hi => hp.nonzero i (Subtype.ext hi)
  · exact fun i => congrArg Subtype.val (hp.idempotent i)
  · exact fun i j hij => congrArg Subtype.val (hp.orthogonal i j hij)
  · have h₁ := congrArg S.toSubmodule.subtype hp.sum_eq_one
    rw [map_sum] at h₁
    exact h₁
  · have h₂ := congrArg S.toSubmodule.subtype (heval X)
    simp only [aeval_X, eval_X, map_sum, map_smul] at h₂
    exact h₂
  · exact fun i => (p i).property
  · intro f
    rw [powerEval_eq_aeval]
    have h := congrArg S.toSubmodule.subtype (heval f)
    simp only [map_sum, map_smul] at h
    exact h

end TauCeti.Jordan
